---
// 가로 장표(16:9) 한 벌. 홈(config.ts)과 프로젝트 상세(src/content/projects/*.md)를 세로 PDF(PrintDocument)와 같은 원천에서 읽는다.
// 세로 PDF와 다른 점: 전부 싣지 않는다. 대표 프로젝트 몇 개와 그 안의 사례 몇 건만 고르고(deck), 나머지는 표 한 장에서 사이트로 보낸다.
// 분량 기준(2026-11-24): 프로젝트 2~3개 · 프로젝트당 6~7장 · 그중 사례 2~3장. 글은 줄이지 않고 그대로 싣는다 — 줄일 것은 장수다.
import fs from "node:fs";
import path from "node:path";
import { getCollection } from "astro:content";
import { siteConfig } from "../../config";
import { emphasize } from "../../lib/emphasize";
import Slide from "./Slide.astro";
import OwnershipMap from "../OwnershipMap.astro";
import Tag from "../Tag.astro";
import PickageFlow from "../visuals/PickageFlow.astro";
import BeezFlow from "../visuals/BeezFlow.astro";
import BlockBattleFlow from "../visuals/BlockBattleFlow.astro";
import LockDiagram from "../visuals/LockDiagram.astro";
import Timeline0728 from "../visuals/Timeline0728.astro";
import NotifyOrder from "../visuals/NotifyOrder.astro";
import GuardChain from "../visuals/GuardChain.astro";
import ExportChart from "../visuals/ExportChart.astro";
import VotesChart from "../visuals/VotesChart.astro";

const flows: Record<string, any> = { PickageFlow, BeezFlow, BlockBattleFlow };
const visuals: Record<string, any> = { LockDiagram, Timeline0728, NotifyOrder, GuardChain, ExportChart, VotesChart };

interface Props {
  variant: {
    title: string;
    roleLabel: string;
    hero: typeof siteConfig.hero;
    aboutMe: string[];
    strengths: typeof siteConfig.strengths;
    skills: typeof siteConfig.skills;
    projectOrder?: string[];
  };
  // 싣는 프로젝트와 그 안에서 싣는 사례 id. 적은 순서대로 나온다.
  deck: { slug: string; cases: string[] }[];
}
const { variant: v, deck } = Astro.props;

const KEY_LABELS = ["결과", "측정 결과", "해결"];
const isKey = (s: { label: string; key?: boolean; limit?: boolean }) => !s.limit && (s.key ?? KEY_LABELS.includes(s.label));

const all = await getCollection("projects");
const rank = (id: string, fallback: number) => (v.projectOrder ? v.projectOrder.indexOf(id) : fallback);
const listed = all.filter((p) => !v.projectOrder || v.projectOrder.includes(p.id)).sort((a, b) => rank(a.id, a.data.order) - rank(b.id, b.data.order));
const picked = deck.map((d) => {
  const p = all.find((x) => x.id === d.slug);
  if (!p) throw new Error(`장표에 적은 프로젝트가 없습니다: ${d.slug}`);
  const cases = d.cases.map((id) => {
    const c = p.data.cases.find((x) => x.id === id);
    if (!c) throw new Error(`장표에 적은 사례가 없습니다: ${d.slug}#${id}`);
    const n = c.steps.reduce((k, s) => k + s.text.length, 0);
    // 결과 단은 제목 바로 아래 띠로 올린다(같은 문장을 옮기기만 한다) — 제목과 결과만 읽고 넘겨도 요점이 남게.
    const lead = c.steps.find((s) => isKey(s));
    const rest = c.steps.filter((s) => s !== lead);
    // 도식이 없으면 글만 두 단(plain), 도식이 있고 짧으면 도식과 글을 한 장에 나란히(side),
    // 도식이 있고 길면 두 장(two): 앞 장은 도식 옆에 앞쪽 절반, 뒤 장은 결과 띠와 나머지.
    const layout = !c.visual ? "plain" : n <= 520 ? "side" : "two";
    // 두 장으로 나눌 때는 글자 수가 절반에 가장 가까워지는 자리에서 자른다.
    const half = rest.reduce((k, s) => k + s.text.length, 0) / 2;
    let acc = 0;
    let cut = 1;
    let best = Infinity;
    rest.forEach((s, i) => {
      acc += s.text.length;
      const gap = Math.abs(acc - half);
      if (i + 1 !== rest.length && gap + 0.5 <= best) {
        best = gap;
        cut = i + 1;
      }
    });
    return { ...c, n, lead, rest, layout, first: rest.slice(0, cut), second: rest.slice(cut), shownTags: c.tags.filter((t) => t.type !== "limit") };
  });
  return { p, cases };
});

// 줄 끝에서 날짜·범위가 갈리지 않게 묶는다(2026-11 → "2026-" / "11", 10–12시 → "10–" / "12시").
const rich = (t: string) => emphasize(t).replace(/\d[\d.]*[-–]\d[\d.\-–]*/g, (m) => `<span class="nw">${m}</span>`);

const siteUrl = "https://dreaminggenie.github.io";
const owner = `${siteConfig.name} · ${v.title} 포트폴리오`;
const hasImage = (src?: string) => !!src && fs.existsSync(path.join(process.cwd(), "public", src));

// 사이트 안 링크(/projects/tripcraft#lock): 이 문서에 실린 자리면 문서 안 앵커로, 아니면 사이트 주소로 보낸다.
const inDeck = new Set<string>();
for (const { p, cases } of picked) {
  for (const x of p.data.did) if (x.id) inDeck.add(`${p.id}-${x.id}`);
  for (const c of cases) inDeck.add(`${p.id}-${c.id}`);
}
const toHref = (href: string) => {
  const m = href.match(/^\/projects\/([^#]+)#(.+)$/);
  if (m && inDeck.has(`${m[1]}-${m[2]}`)) return `#${m[1]}-${m[2]}`;
  return href.startsWith("/") ? siteUrl + href : href;
};

// 한 장에 다 들어가게 글자 수로 본문 크기를 고른다(견본 실측: 694자는 20px, 1,149자는 16px까지 들어갔다).
// 여기서 고른 값은 시작 크기이고, 실제로 넘치면 Deck.astro 의 스크립트가 더 줄인다.
const stepFs = (n: number) => (n <= 560 ? 19 : n <= 760 ? 18 : 17);

// '한 일' 카드는 두 단에 들어가는 만큼씩 장을 나눈다. 카드 높이는 글자 수로 어림한다.
const cardH = (x: { text: string }) => 110 + x.text.length * 0.7;
const didFs = (items: { text: string }[]) => {
  const h = items.reduce((n, x) => n + cardH(x), 0);
  return h <= 700 ? 19 : 17;
};
const chunkDid = <T extends { text: string }>(items: T[]) => {
  const out: T[][] = [];
  let cur: T[] = [];
  let h = 0;
  for (const x of items) {
    if (cur.length && h + cardH(x) > 1000) {
      out.push(cur);
      cur = [];
      h = 0;
    }
    cur.push(x);
    h += cardH(x);
  }
  if (cur.length) out.push(cur);
  return out;
};

const timelineL = siteConfig.experience.map((e) => ({ title: e.title, org: e.company, date: e.dateRange, bullets: e.bullets }));
const timelineR = siteConfig.education.map((e) => ({ title: e.degree, org: e.school, date: e.dateRange, bullets: e.achievements }));
---

<main class="deck">
  <!-- 표지 -->
  <Slide bare class="cover">
    <div class="cover-grid">
      <div>
        <p class="eyebrow">{v.hero.eyebrow}</p>
        <h1>{v.hero.headline}</h1>
        <p class="who">{v.roleLabel} <b>{siteConfig.name}</b>입니다.</p>
        <p class="intro">{v.hero.intro}</p>
        <ul class="contacts">
          {siteConfig.contacts.map((c) => <li><span class="k">{c.label}</span>{c.href ? <a href={c.href}>{c.value}</a> : c.value}</li>)}
          <li><span class="k">Web</span><a href={siteUrl}>dreaminggenie.github.io</a></li>
        </ul>
      </div>
      {hasImage(siteConfig.profileImage) && <img src={siteConfig.profileImage} alt={`${siteConfig.name} 프로필 사진`} />}
    </div>
    <Fragment slot="foot">{siteUrl.replace("https://", "")}</Fragment>
  </Slide>

  <!-- 소개 -->
  <Slide label="소개" owner={owner}>
    <h1>해 온 일</h1>
    <div class="rule about">
      {v.aboutMe.map((p) => <p set:html={emphasize(p)} />)}
    </div>
  </Slide>

  <!-- 일하는 방식 -->
  <Slide label="소개" sub="일하는 방식" owner={owner}>
    <h1>제가 일하는 방식</h1>
    <div class="rule">
      <div class="strengths">
        {
          v.strengths.map((s, i) => (
            <div>
              <span class="n">0{i + 1}</span>
              <h2>{s.title}</h2>
              <p>{s.body}</p>
              <ul>
                {s.links.map((l) => <li><a href={toHref(l.href)}>{l.label}</a></li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </Slide>

  <!-- 프로젝트 한눈에 -->
  <Slide label="프로젝트" owner={owner}>
    <h1>프로젝트</h1>
    <p class="lede">이 문서에는 {picked.length}개만 자세히 실었습니다. 나머지와 근거 모음은 사이트에 있습니다.</p>
    <div class="rule">
      <table class="proj">
        <colgroup><col style="width:2.4rem" /><col style="width:31%" /><col style="width:21%" /><col style="width:19%" /><col /></colgroup>
        <thead>
          <tr><th></th><th>프로젝트</th><th>기간 · 팀</th><th>맡은 일</th><th>대표 한 줄</th></tr>
        </thead>
        <tbody>
          {
            listed.map((p, i) => {
              const here = picked.some((x) => x.p.id === p.id);
              return (
                <tr>
                  <td class="no">0{i + 1}</td>
                  <td>
                    <a href={here ? `#${p.id}` : `${siteUrl}/projects/${p.id}`}><b>{p.data.title}</b><span class={`where ${here ? "in" : "out"}`}>{here ? "이 문서" : "사이트"}</span></a>
                    <small>{p.data.summary}</small>
                  </td>
                  <td>{p.data.period}<small>{p.data.team}</small></td>
                  <td>{p.data.role}</td>
                  <td class="hl">{p.data.highlight}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </Slide>

  <!-- 기술 -->
  <Slide label="기술" owner={owner}>
    <h1>기술</h1>
    <p class="lede">설명할 수 있는 깊이로 나누고, 어디에 썼는지 함께 적었습니다.</p>
    <div class="rule skills">
      {
        v.skills.map((t, i) => (
          <section>
            <h2>{t.tier}<small>{t.note}</small></h2>
            {i === 0 ? (
              <dl>{t.items.map((s) => <div><dt>{s.name}</dt><dd>{s.where}</dd></div>)}</dl>
            ) : (
              <ul>{t.items.map((s) => <li><b>{s.name}</b><span> · {s.where}</span></li>)}</ul>
            )}
          </section>
        ))
      }
    </div>
  </Slide>

  <!-- 이력 -->
  <Slide label="이력" owner={owner}>
    <h1>이력</h1>
    <div class="rule">
      <div class="cv">
        {
          [
            { h: "경험 · 개인 작업", items: timelineL, side: true },
            { h: "학력 · 수상 · 자격", items: timelineR, side: false },
          ].map((col) => (
            <div>
              <h2>{col.h}</h2>
              {col.items.map((it) => (
                <div class="item">
                  <p class="org">{it.org}{it.date && <span>{it.date}</span>}</p>
                  <p class="ttl">{it.title}</p>
                  <ul>{it.bullets.map((b) => <li>{b}</li>)}</ul>
                </div>
              ))}
              {col.side &&
                siteConfig.sideProjects.map((p) => (
                  <div class="item">
                    <p class="org">{p.name}<span>{p.link.replace("https://", "")}</span></p>
                    <p class="ttl">개인 작업 · {p.skills.join(" · ")}</p>
                    <ul>
                      <li>{p.description}</li>
                      {p.points.map((pt) => <li>{pt}</li>)}
                    </ul>
                  </div>
                ))}
            </div>
          ))
        }
      </div>
    </div>
  </Slide>

  <!-- 대표 프로젝트 -->
  {
    picked.map(({ p, cases }, i) => {
      const d = p.data;
      const Flow = d.flow ? flows[d.flow] : null;
      const img = hasImage(d.cover);
      const didChunks = chunkDid(d.did);
      return (
        <>
          {/* 개요 */}
          <Slide id={p.id} label={d.title} sub="개요" owner={owner}>
            <div class={`overview ${img ? "" : "noimg"}`}>
              <div>
                <span class="n">0{i + 1}</span>
                <h1>{d.title}</h1>
                <p class="one">{d.oneLine}</p>
                <dl>
                  <div><dt>기간</dt><dd>{d.period}</dd></div>
                  <div><dt>팀</dt><dd>{d.team}</dd></div>
                  <div><dt>맡은 일</dt><dd>{d.role}</dd></div>
                </dl>
                <div class="stack">
                  {d.stack.map((s) => <span>{s}</span>)}
                </div>
              </div>
              {img && (
                <figure>
                  <img src={d.cover} alt={`${d.title} 대표 화면`} />
                  {d.shotNote && <figcaption>{d.shotNote}</figcaption>}
                </figure>
              )}
            </div>
            <Fragment slot="foot">{d.repo ? <a href={d.repo}>{d.repo.replace("https://", "")}</a> : `${siteUrl.replace("https://", "")}/projects/${p.id}`}</Fragment>
          </Slide>

          {/* 담당 영역 */}
          <Slide label={d.title} sub="담당 영역" owner={owner}>
            <h1>시스템에서 제가 맡은 부분</h1>
            <div class="rule own">
              <OwnershipMap areas={d.areas} />
            </div>
          </Slide>

          {/* 데이터 흐름 */}
          {Flow && (
            <Slide label={d.title} sub="데이터 흐름" owner={owner}>
              <h1>데이터 흐름</h1>
              <div class="rule">
                <Flow />
              </div>
            </Slide>
          )}

          {/* 한 일 */}
          {didChunks.map((chunk, k) => {
            return (
              <Slide label={d.title} sub={didChunks.length > 1 ? `한 일 ${k + 1}/${didChunks.length}` : "한 일"} owner={owner}>
                <h1>한 일</h1>
                <div class="rule">
                  <div class="did" data-fit={didFs(chunk)}>
                    {chunk.map((x) => (
                      <div id={x.id ? `${p.id}-${x.id}` : undefined}>
                        <h2>{x.title}</h2>
                        <p set:html={rich(x.text)} />
                        {x.evidence.length > 0 && <div class="ev">{x.evidence.map((e) => <code>{e}</code>)}</div>}
                      </div>
                    ))}
                  </div>
                </div>
              </Slide>
            );
          })}

          {/* 사례 */}
          {cases.map((c) => {
            const Visual = c.visual ? visuals[c.visual] : null;
            const tags = c.shownTags;
            const stepList = (items: typeof c.rest, one: boolean, size: number) => (
              <dl class={`steps ${one ? "one" : ""}`} data-fit={size}>
                {items.map((s) => (
                  <div class={`${isKey(s) ? "is-key" : ""} ${s.limit ? "is-limit" : ""}`}>
                    <dt>{s.label}</dt>
                    <dd set:html={rich(s.text)} />
                  </div>
                ))}
              </dl>
            );
            const leadBand = c.lead && (
              <div class="lead">
                <span>{c.lead.label}</span>
                <p set:html={rich(c.lead.text)} />
              </div>
            );
            const tagRow = tags.length > 0 && <div class="tags">{tags.map((t) => <Tag type={t.type} text={t.text} />)}</div>;
            const ev = c.evidence.map((e) => <code>{e}</code>);
            return c.layout === "two" ? (
              <>
                {/* 긴 사례 + 도식: 앞 장은 도식 옆에 앞쪽 단(무슨 문제였고 무엇을 골랐나), 뒤 장은 결과 띠와 나머지 단 */}
                <Slide id={`${p.id}-${c.id}`} label={d.title} sub={`${c.kind} · 1/2`} owner={owner}>
                  <h1>{c.title}</h1>
                  {tagRow}
                  <div class="rule">
                    <div class="split wide">
                      <div class="visual stacked">
                        {c.visual === "LockDiagram" ? (
                          <>
                            <Visual mode="nolock" />
                            <Visual mode="lock" />
                          </>
                        ) : (
                          <Visual />
                        )}
                      </div>
                      {stepList(c.first, true, 18)}
                    </div>
                  </div>
                  <Fragment slot="foot">{ev}</Fragment>
                </Slide>
                <Slide label={d.title} sub={`${c.kind} · 2/2`} owner={owner}>
                  <h1>{c.title}</h1>
                  {leadBand}
                  <div class="rule">{stepList(c.second, false, 19)}</div>
                  <Fragment slot="foot">{ev}</Fragment>
                </Slide>
              </>
            ) : (
              <Slide id={`${p.id}-${c.id}`} label={d.title} sub={c.kind} owner={owner}>
                <h1>{c.title}</h1>
                {tagRow}
                {leadBand}
                <div class="rule">
                  {c.layout === "side" ? (
                    <div class="split">
                      <div class="visual" data-zoom="1.15"><Visual /></div>
                      {stepList(c.rest, true, 18)}
                    </div>
                  ) : (
                    stepList(c.rest, false, stepFs(c.n))
                  )}
                </div>
                <Fragment slot="foot">{ev}</Fragment>
              </Slide>
            );
          })}
        </>
      );
    })
  }
</main>
