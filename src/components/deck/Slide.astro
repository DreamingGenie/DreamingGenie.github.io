---
// 장표 한 장의 틀: 위 줄(어느 프로젝트·무슨 장인지) · 본문 · 아래 줄(근거 또는 사이트 주소 · 쪽 번호).
interface Props {
  id?: string;
  label?: string; // 위 줄 왼쪽의 강조색 낱말(프로젝트 이름 등)
  sub?: string; // 그 옆의 설명
  owner?: string; // 위 줄 오른쪽
  class?: string;
  bare?: boolean; // 표지처럼 위 줄을 그리지 않는다
}
const { id, label, sub, owner, class: cls = "", bare = false } = Astro.props;
---

<section id={id} class={`slide ${cls}`}>
  {
    !bare && (
      <div class="slide-top">
        <span>
          {label && <b>{label}</b>}
          {sub && <span>{label ? " | " : ""}{sub}</span>}
        </span>
        <span>{owner}</span>
      </div>
    )
  }
  <div class="slide-body"><slot /></div>
  <div class="slide-foot">
    <span class="ev"><slot name="foot" /></span>
    <span class="slide-no"></span>
  </div>
</section>
