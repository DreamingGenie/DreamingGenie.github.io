---
import { siteConfig } from "../config";
import SectionTitle from "./SectionTitle.astro";
---

<section id="skills" class="bg-gray-50 border-y border-gray-200">
  <div class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-20 md:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <SectionTitle title="기술" sub="설명할 수 있는 깊이로 나누고, 어디에 썼는지 함께 적었습니다." />
      <div class="lg:col-span-8 flex flex-col gap-6">
        {
          siteConfig.skills.map((t, i) => (
            <div class="bg-white rounded-2xl border border-gray-200 p-5 sm:p-8">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-5">
                <h3 class="text-xl font-bold text-gray-900">{t.tier}</h3>
                <span class="text-sm text-gray-500">{t.note}</span>
              </div>
              <ul class={i === 0 ? "divide-y divide-gray-100" : "flex flex-wrap gap-2"}>
                {t.items.map((s) =>
                  i === 0 ? (
                    <li class="grid grid-cols-1 sm:grid-cols-[13rem_1fr] gap-1 sm:gap-6 py-3 first:pt-0 last:pb-0">
                      <span class="font-semibold text-gray-900">{s.name}</span>
                      <span class="text-gray-600">{s.where}</span>
                    </li>
                  ) : (
                    <li class="px-3 py-1.5 bg-gray-100 rounded-lg text-[0.9375rem] text-gray-800">
                      <span class="font-medium">{s.name}</span>
                      <span class="text-gray-500"> · {s.where}</span>
                    </li>
                  ),
                )}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
