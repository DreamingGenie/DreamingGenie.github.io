---
// 담당 영역 지도. 비율 대신 "시스템의 어느 칸이 내 것인지"를 보여 준다.
// 2026-11-28 피드백 반영: 팀원이 맡은 칸(team)은 그리지 않고, 함께 한 칸(shared)은 제 칸과 같게 그린다.
// 원고의 team 칸은 사실 기록으로 남겨 두고 화면에서만 뺀다. 칸이 하나도 남지 않는 묶음은 통째로 뺀다.
interface Item { name: string; owner: "me" | "team" | "shared"; note?: string }
interface Props { areas: { group: string; items: Item[] }[] }
const { areas } = Astro.props;

const shown = areas
  .map((a) => ({ ...a, items: a.items.filter((it) => it.owner !== "team") }))
  .filter((a) => a.items.length > 0);
---

<div class="flex flex-col gap-5">
  {
    shown.map((a) => (
      <div class="om-row grid grid-cols-1 sm:grid-cols-[8rem_1fr] gap-2 sm:gap-6 items-start">
        <h4 class="text-sm font-semibold text-gray-500 sm:pt-3">{a.group}</h4>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {a.items.map((it) => (
            <li class="rounded-xl px-4 py-3 text-white border-transparent" style="background-color: var(--accent)">
              <span class="block font-semibold text-[0.9375rem]">{it.name}</span>
              {it.note && <span class="block text-xs mt-0.5 text-white/80">{it.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
