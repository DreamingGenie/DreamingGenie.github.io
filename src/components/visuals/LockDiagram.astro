---
// TripCraft 여행 단위 락. "락 없이 / 여행 단위 락" 두 상태를 버튼으로 바꿔 본다.
// mode 를 넘기면 버튼 없이 그 상태만 고정해 그린다(PDF처럼 누를 수 없는 매체용).
interface Props {
  mode?: "lock" | "nolock";
}
const { mode } = Astro.props;
const fixed = mode !== undefined;
const current = mode ?? "lock";
---

<figure class="lockfig-wrap flex flex-col gap-4" data-mode={current}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-gray-600 max-w-md">
      {fixed && <span class="font-semibold text-gray-800">{current === "lock" ? "여행 단위 락 — " : "락 없이 — "}</span>}두 사람이 같은 여행에 시간이 겹치는 일정을 동시에 넣습니다.
    </p>
    {
      !fixed && (
        <div class="inline-flex rounded-full bg-gray-100 p-1 ring-1 ring-gray-200" role="group" aria-label="락 방식">
          <button type="button" data-mode="nolock" aria-pressed="false" class="lock-btn px-4 py-1.5 rounded-full text-sm font-semibold text-gray-600">락 없이</button>
          <button type="button" data-mode="lock" aria-pressed="true" class="lock-btn px-4 py-1.5 rounded-full text-sm font-semibold text-gray-600">여행 단위 락</button>
        </div>
      )
    }
  </div>
  <!--
    한 장(660폭)에 그리던 것을 '요청 처리 순서'와 '저장된 일정표' 두 장으로 나눴다(2026-11-22).
    한 장이면 본문 칸에서 글씨가 10px대로 줄고 휴대폰에서는 가로 스크롤 뒤에 결과(거절)가 숨었다.
    넓은 화면에서는 나란히, 좁은 화면에서는 위아래로 놓는다.
  -->
  <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] gap-5 sm:gap-6 items-start">
    <svg class="lockfig" viewBox="0 0 352 216" role="img" aria-label="락이 없으면 겹치는 두 일정이 모두 저장되고, 여행 단위 락이 있으면 두 번째 요청이 방금 저장된 일정을 보고 거절되는 흐름">
      <text x="0" y="14" class="t-muted t-small">요청 처리 순서 →</text>
      <text x="0" y="44" class="t-strong">A · 10–12시 박물관 추가</text>
      <text x="0" y="122" class="t-strong">B · 11–13시 시장 추가</text>

      <g class="m-nolock">
        <rect x="0" y="54" width="130" height="28" rx="5" class="s-check"></rect><text x="10" y="73">겹침 검사 · 없음</text>
        <rect x="130" y="54" width="64" height="28" rx="5" class="s-save"></rect><text x="146" y="73" class="t-on">저장</text>
        <rect x="30" y="132" width="130" height="28" rx="5" class="s-check"></rect><text x="40" y="151">겹침 검사 · 없음</text>
        <rect x="160" y="132" width="64" height="28" rx="5" class="s-save"></rect><text x="176" y="151" class="t-on">저장</text>
        <text x="0" y="190" class="t-bad">두 검사 모두 상대 일정이 저장되기 전에</text>
        <text x="0" y="210" class="t-bad">실행돼 함께 통과합니다</text>
      </g>

      <g class="m-lock">
        <rect x="0" y="54" width="40" height="28" rx="5" class="s-lock"></rect><text x="13" y="73">락</text>
        <rect x="40" y="54" width="90" height="28" rx="5" class="s-check"></rect><text x="52" y="73">겹침 검사</text>
        <rect x="130" y="54" width="64" height="28" rx="5" class="s-save"></rect><text x="146" y="73" class="t-on">저장</text>
        <line x1="194" y1="48" x2="194" y2="170" class="s-tick"></line>
        <text x="200" y="44" class="t-small t-muted">A 저장 끝 · 락 풀림</text>
        <rect x="30" y="132" width="164" height="28" rx="5" class="s-wait"></rect><text x="42" y="151" class="t-muted">락 대기</text>
        <rect x="194" y="132" width="90" height="28" rx="5" class="s-check"></rect><text x="206" y="151">겹침 검사</text>
        <rect x="284" y="132" width="56" height="28" rx="5" class="s-rej"></rect><text x="297" y="151" class="t-bad">거절</text>
        <text x="340" y="178" text-anchor="end" class="t-small t-muted">방금 저장된 A 일정을 봅니다</text>
        <text x="0" y="208" class="t-good">한 여행 안에서는 한 사람씩 차례로 저장합니다</text>
      </g>
    </svg>

    <svg class="lockfig lockfig-table" viewBox="0 0 196 216" role="img" aria-label="저장된 일정표: 락이 없으면 11–12시가 겹치고, 락이 있으면 시장 일정은 저장되지 않는다">
      <text x="0" y="14" class="t-muted t-small">저장된 일정표</text>
      <g class="s-grid">
        <line x1="40" y1="40" x2="196" y2="40"></line><line x1="40" y1="80" x2="196" y2="80"></line>
        <line x1="40" y1="120" x2="196" y2="120"></line><line x1="40" y1="160" x2="196" y2="160"></line>
      </g>
      <text x="0" y="44" class="t-muted t-small">10시</text><text x="0" y="84" class="t-muted t-small">11시</text>
      <text x="0" y="124" class="t-muted t-small">12시</text><text x="0" y="164" class="t-muted t-small">13시</text>

      <g class="m-nolock">
        <rect x="46" y="40" width="68" height="80" rx="5" class="s-blk-a"></rect><text x="54" y="60" class="t-small">박물관</text>
        <rect x="122" y="80" width="68" height="80" rx="5" class="s-blk-b"></rect><text x="130" y="100" class="t-small">시장</text>
        <rect x="40" y="80" width="156" height="40" class="s-over"></rect>
        <text x="0" y="192" class="t-bad">둘 다 저장</text>
        <text x="0" y="210" class="t-bad">11–12시 겹침</text>
      </g>

      <g class="m-lock">
        <rect x="46" y="40" width="68" height="80" rx="5" class="s-blk-a"></rect><text x="54" y="60" class="t-small">박물관</text>
        <rect x="122" y="80" width="68" height="80" rx="5" class="s-ghost"></rect><text x="130" y="100" class="t-small t-muted">시장</text>
        <text x="0" y="192" class="t-good">겹침 없음</text>
        <text x="0" y="210" class="t-good">B는 다시 고름</text>
      </g>
    </svg>
  </div>
</figure>

<style>
  .lockfig { display: block; width: 100%; height: auto; overflow: visible; }
  /* 휴대폰에서 위아래로 놓일 때 일정표 글씨가 위 그림과 같은 크기가 되게(왼쪽 그림 352폭 : 일정표 196폭) */
  @media (max-width: 639px) {
    .lockfig-table { max-width: 56%; }
  }
  .lockfig text { fill: #1f2937; font-family: var(--font-sans); font-size: 14px; }
  .lockfig .t-strong { font-weight: 600; }
  .lockfig .t-muted { fill: #6b7280; }
  .lockfig .t-small { font-size: 12.5px; }
  .lockfig .t-on { fill: #ffffff; font-weight: 600; }
  .lockfig .t-bad { fill: #be123c; font-weight: 600; }
  .lockfig .t-good { fill: var(--accent); font-weight: 600; }
  .lockfig .s-check { fill: #f3f4f6; stroke: #9ca3af; }
  .lockfig .s-save { fill: var(--accent); stroke: var(--accent); }
  .lockfig .s-lock { fill: #fef3c7; stroke: #d97706; }
  .lockfig .s-wait { fill: #fffbeb; stroke: #d97706; stroke-dasharray: 4 4; }
  .lockfig .s-rej { fill: #ffe4e6; stroke: #e11d48; }
  .lockfig .s-grid { stroke: #e5e7eb; fill: none; }
  .lockfig .s-blk-a { fill: #dbeafe; stroke: var(--accent); }
  .lockfig .s-blk-b { fill: #e0e7ff; stroke: #4f46e5; }
  .lockfig .s-ghost { fill: none; stroke: #e11d48; stroke-dasharray: 4 3; }
  .lockfig .s-over { fill: #e11d48; opacity: 0.22; }
  .lockfig .s-tick { stroke: #374151; stroke-width: 1.5; stroke-dasharray: 2 3; }
  .lockfig-wrap[data-mode="nolock"] .m-lock,
  .lockfig-wrap[data-mode="lock"] .m-nolock { display: none; }
  .lock-btn[aria-pressed="true"] { background: #ffffff; color: #111827; box-shadow: 0 1px 2px rgb(0 0 0 / 0.08); }
  @media (prefers-reduced-motion: no-preference) {
    .lockfig g { animation: lockfade 0.3s ease; }
  }
  @keyframes lockfade { from { opacity: 0.3; } to { opacity: 1; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".lockfig-wrap").forEach((wrap) => {
    const btns = wrap.querySelectorAll<HTMLButtonElement>(".lock-btn");
    btns.forEach((b) =>
      b.addEventListener("click", () => {
        wrap.dataset.mode = b.dataset.mode;
        btns.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
      }),
    );
  });
</script>
