---
// 가로 막대 비교. max 하나로 모든 막대와 눈금을 같은 축척으로 그린다.
interface Bar { label: string; value: number; display: string; tone?: "accent" | "bad" | "muted" }
interface Props { caption: string; max: number; unit: string; bars: Bar[]; note?: string }
const { caption, max, unit, bars, note } = Astro.props;
const ticks = [0, max / 2, max];
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
const color = (t?: string) => (t === "bad" ? "#e11d48" : t === "muted" ? "#9ca3af" : "var(--accent)");
---

<figure class="flex flex-col gap-3">
  <figcaption class="text-sm font-semibold text-gray-800">{caption}</figcaption>
  {
    bars.map((b) => (
      <div class="grid grid-cols-[1fr_5.5rem] sm:grid-cols-[11rem_1fr_6rem] gap-x-4 gap-y-1 items-center">
        <span class="col-span-2 sm:col-span-1 text-sm text-gray-600">{b.label}</span>
        <span class="h-4 rounded bg-gray-100 overflow-hidden">
          <span class="block h-full rounded" style={`width: ${Math.max((b.value / max) * 100, 0.6)}%; background-color: ${color(b.tone)}`} />
        </span>
        <span class="font-mono text-sm text-gray-900 text-right tabular-nums">{b.display}</span>
      </div>
    ))
  }
  <div class="grid grid-cols-[1fr_5.5rem] sm:grid-cols-[11rem_1fr_6rem] gap-x-4">
    <span class="hidden sm:block"></span>
    <span class="flex justify-between font-mono text-xs text-gray-400">
      {ticks.map((t, i) => <span>{fmt(t)}{i === ticks.length - 1 ? ` ${unit}` : ""}</span>)}
    </span>
  </div>
  {note && <p class="text-sm text-gray-500">{note}</p>}
</figure>
