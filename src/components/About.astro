---
import { siteConfig } from "../config";
import SectionTitle from "./SectionTitle.astro";

// 소개 문단의 **…** 를 굵게 바꾼다. 원문은 config.ts 에서만 오지만, HTML 특수문자는 먼저 이스케이프한다.
const emphasize = (t: string) =>
  t
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-gray-900">$1</strong>');
---

<section id="about" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-20 md:py-28">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
    <SectionTitle title="소개" />
    <div class="lg:col-span-8 flex flex-col gap-12">
      <div class="flex flex-col gap-6">
        {siteConfig.aboutMe.map((p) => <p class="text-lg sm:text-xl leading-relaxed text-gray-600" set:html={emphasize(p)} />)}
        {siteConfig.showAiNote && <p class="text-base leading-relaxed text-gray-500">{siteConfig.aiNote}</p>}
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-base font-semibold text-gray-700">제가 일하는 방식</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {
            siteConfig.strengths.map((s, i) => (
              <article class="flex flex-col gap-3 p-5 sm:p-6 bg-gray-50 rounded-2xl border border-gray-200">
                <span class="font-mono text-sm" style="color: var(--accent)">0{i + 1}</span>
                <h4 class="text-lg font-bold text-gray-900 leading-snug">{s.title}</h4>
                <p class="text-base text-gray-600 leading-relaxed">{s.body}</p>
                <ul class="pt-4 border-t border-gray-200 flex flex-col gap-2">
                  {s.links.map((l) => (
                    <li>
                      <a href={l.href} class="group flex items-start gap-2 text-[0.9375rem] text-gray-700 hover:text-[var(--accent)] transition-colors">
                        <span aria-hidden="true" class="font-mono text-gray-400 group-hover:text-[var(--accent)]">→</span>
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
