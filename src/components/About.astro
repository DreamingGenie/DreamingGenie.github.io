---
import { siteConfig } from "../config";
import SectionTitle from "./SectionTitle.astro";
import { emphasize } from "../lib/emphasize";

interface Props {
  aboutMe?: string[];
  strengths?: typeof siteConfig.strengths;
}
const { aboutMe = siteConfig.aboutMe, strengths = siteConfig.strengths } = Astro.props;
---

<section id="about" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-20 md:py-28">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
    <SectionTitle title="소개" />
    <div class="lg:col-span-8 flex flex-col gap-12">
      <div class="flex flex-col gap-6">
        {aboutMe.map((p) => <p class="text-lg sm:text-xl leading-relaxed text-gray-600" set:html={emphasize(p)} />)}
        {siteConfig.showAiNote && <p class="text-base leading-relaxed text-gray-500">{siteConfig.aiNote}</p>}
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-base font-semibold text-gray-700">제가 일하는 방식</h3>
        <!-- 3열 카드는 본문 칸(704px) 안에서 한 줄 10자 안팎으로 좁아져, 한 줄에 하나씩 왼쪽 설명 · 오른쪽 사례 링크로 둔다 -->
        <div class="flex flex-col gap-4">
          {
            strengths.map((s, i) => (
              <article class="grid grid-cols-1 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] gap-4 md:gap-8 p-5 sm:p-6 bg-gray-50 rounded-2xl border border-gray-200">
                <div class="flex flex-col gap-2">
                  <span class="font-mono text-sm" style="color: var(--accent)">0{i + 1}</span>
                  <h4 class="text-lg font-bold text-gray-900 leading-snug">{s.title}</h4>
                  <p class="text-base text-gray-600 leading-relaxed">{s.body}</p>
                </div>
                <ul class="pt-4 md:pt-0 md:pl-8 border-t md:border-t-0 md:border-l border-gray-200 flex flex-col gap-2 md:justify-center">
                  {s.links.map((l) => (
                    <li>
                      <a href={l.href} class="group flex items-start gap-2 text-[0.9375rem] text-gray-700 hover:text-[var(--accent)] transition-colors">
                        <span aria-hidden="true" class="font-mono text-gray-400 group-hover:text-[var(--accent)]">→</span>
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
