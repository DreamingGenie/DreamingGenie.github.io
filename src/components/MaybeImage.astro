---
// public/ 아래에 파일이 있으면 그림을, 없으면 개발 서버에서만 자리 표시를 보여 준다.
// 배포 빌드에서는 빈 자리를 아예 그리지 않는다.
import fs from "node:fs";
import path from "node:path";

interface Props {
  src?: string;
  alt: string;
  class?: string;
  label?: string;
}
const { src, alt, class: className = "", label } = Astro.props;
const exists = !!src && fs.existsSync(path.join(process.cwd(), "public", src));
const showPlaceholder = !exists && import.meta.env.DEV && !!src;
---

{exists && <img src={src} alt={alt} loading="lazy" class={`object-cover ${className}`} />}
{
  showPlaceholder && (
    <div
      class={`flex flex-col items-center justify-center gap-1 border-2 border-dashed border-gray-300 bg-gray-50 text-gray-400 text-center p-4 ${className}`}
    >
      <span class="text-sm font-medium">{label ?? "이미지 자리"}</span>
      <code class="font-mono text-xs break-all">public{src}</code>
    </div>
  )
}
