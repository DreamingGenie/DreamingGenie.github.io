---
import { getCollection } from "astro:content";
import SectionTitle from "./SectionTitle.astro";
import MaybeImage from "./MaybeImage.astro";

// order(슬러그 목록)를 넘기면 그 순서로, 아니면 각 md의 order 값으로 정렬한다(직무별 첫 화면용).
interface Props {
  order?: string[];
}
const { order } = Astro.props;
const rank = (id: string, fallback: number) => (order ? order.indexOf(id) : fallback);
const STACK_SHOWN = 6;
const projects = (await getCollection("projects"))
  .filter((p) => !order || order.includes(p.id))
  .sort((a, b) => rank(a.id, a.data.order) - rank(b.id, b.data.order));
---

<section id="projects" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-20 md:py-28">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
    <SectionTitle title="프로젝트" sub="팀 프로젝트는 제가 맡은 부분과 팀원이 맡은 부분을 나눠 적었습니다." />
    <div class="lg:col-span-8 flex flex-col gap-6">
      {
        projects.map((p, i) => (
          <a
            href={`/projects/${p.id}`}
            class="group relative flex flex-col gap-5 p-4 sm:p-5 bg-gray-50 rounded-2xl border border-gray-200 transition-all duration-300 hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
          >
            <!-- 옆에 두면 266px 썸네일이라 화면이 읽히지 않아, 카드 위에 전체 폭으로 두고 위쪽을 기준으로 자른다 -->
            <MaybeImage src={p.data.cover} alt={`${p.data.title} 화면`} label="대표 화면 자리" class="w-full aspect-[16/9] sm:aspect-[3/1] object-top rounded-xl border border-gray-200 bg-white" />
            <div class="flex flex-col gap-3 min-w-0 sm:px-1">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <span class="font-mono text-sm" style="color: var(--accent)">0{i + 1}</span>
                  <h3 class="text-2xl font-bold text-gray-900 mt-0.5">{p.data.title}</h3>
                  <p class="mt-1 text-base text-gray-600 leading-relaxed">{p.data.summary}</p>
                </div>
                <span class="shrink-0 w-10 h-10 flex items-center justify-center bg-gray-900 rounded-full text-white transition-colors group-hover:bg-[var(--accent)]" aria-hidden="true">
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                  </svg>
                </span>
              </div>
              <!-- 카드에서 가장 중요한 한 줄이라 기간·팀보다 앞에 둔다 -->
              <p class="flex items-start gap-2.5 rounded-lg px-3.5 py-2.5 text-base font-semibold text-gray-900 leading-snug" style="background: color-mix(in srgb, var(--accent) 7%, white)">
                <span class="mt-[0.45rem] w-2 h-2 rounded-full shrink-0" style="background-color: var(--accent)" />
                {p.data.highlight}
              </p>
              <dl class="flex flex-col gap-1.5 text-[0.9375rem]">
                <div class="grid grid-cols-[4.5rem_1fr] gap-2"><dt class="text-[13px] text-gray-500 pt-px">기간</dt><dd class="text-gray-800">{p.data.period}</dd></div>
                <div class="grid grid-cols-[4.5rem_1fr] gap-2"><dt class="text-[13px] text-gray-500 pt-px">팀</dt><dd class="text-gray-800">{p.data.team}</dd></div>
                <div class="grid grid-cols-[4.5rem_1fr] gap-2"><dt class="text-[13px] text-gray-500 pt-px">맡은 일</dt><dd class="text-gray-800">{p.data.role}</dd></div>
              </dl>
              <!-- 목록 카드에는 앞의 STACK_SHOWN개만, 전체는 상세 페이지에 있다 -->
              <div class="flex flex-wrap gap-1.5 pt-1">
                {p.data.stack.slice(0, STACK_SHOWN).map((s) => (
                  <span class="px-2 py-0.5 bg-white text-gray-600 ring-1 ring-inset ring-gray-200 rounded-md text-[13px]">{s}</span>
                ))}
                {p.data.stack.length > STACK_SHOWN && (
                  <span class="px-2 py-0.5 text-gray-500 text-[13px]">+{p.data.stack.length - STACK_SHOWN}</span>
                )}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
