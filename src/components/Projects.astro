---
import { getCollection } from "astro:content";
import SectionTitle from "./SectionTitle.astro";
import MaybeImage from "./MaybeImage.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-20 md:py-28">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
    <SectionTitle title="프로젝트" sub="팀 프로젝트는 제가 맡은 부분과 팀원이 맡은 부분을 나눠 적었습니다." />
    <div class="lg:col-span-8 flex flex-col gap-6">
      {
        projects.map((p, i) => (
          <a
            href={`/projects/${p.id}`}
            class="group relative grid grid-cols-1 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-5 md:gap-6 p-4 sm:p-5 bg-gray-50 rounded-2xl border border-gray-200 transition-all duration-300 hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
          >
            <MaybeImage natural src={p.data.cover} alt={`${p.data.title} 화면`} label="대표 화면 자리" class="w-full aspect-[16/9] rounded-xl border border-gray-200 bg-white md:self-center" />
            <div class="flex flex-col gap-3 min-w-0 md:py-1 md:pr-1">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <span class="font-mono text-sm" style="color: var(--accent)">0{i + 1}</span>
                  <h3 class="text-2xl font-bold text-gray-900 mt-0.5">{p.data.title}</h3>
                </div>
                <span class="shrink-0 w-10 h-10 flex items-center justify-center bg-gray-900 rounded-full text-white transition-colors group-hover:bg-[var(--accent)]" aria-hidden="true">
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                  </svg>
                </span>
              </div>
              <p class="text-base text-gray-600 leading-relaxed">{p.data.summary}</p>
              <dl class="flex flex-col gap-1.5 text-[0.9375rem]">
                <div class="grid grid-cols-[4.5rem_1fr] gap-2"><dt class="text-[13px] text-gray-500 pt-px">기간</dt><dd class="text-gray-800">{p.data.period}</dd></div>
                <div class="grid grid-cols-[4.5rem_1fr] gap-2"><dt class="text-[13px] text-gray-500 pt-px">팀</dt><dd class="text-gray-800">{p.data.team}</dd></div>
                <div class="grid grid-cols-[4.5rem_1fr] gap-2"><dt class="text-[13px] text-gray-500 pt-px">맡은 일</dt><dd class="text-gray-800">{p.data.role}</dd></div>
              </dl>
              <p class="flex items-start gap-2 text-base font-semibold text-gray-900">
                <span class="mt-2 w-2 h-2 rounded-full shrink-0" style="background-color: var(--accent)" />
                {p.data.highlight}
              </p>
              <div class="flex flex-wrap gap-1.5 pt-1">
                {p.data.stack.map((s) => (
                  <span class="px-2 py-0.5 bg-white text-gray-600 ring-1 ring-inset ring-gray-200 rounded-md text-[13px]">{s}</span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
