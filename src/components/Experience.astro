---
import { siteConfig } from "../config";
import SectionTitle from "./SectionTitle.astro";

// 경력과 학력을 한 섹션의 타임라인으로 묶는다. 템플릿의 카드·점 모양은 그대로 쓴다.
const items = [
  ...siteConfig.experience.map((e) => ({ title: e.title, org: e.company, date: e.dateRange, bullets: e.bullets })),
  ...siteConfig.education.map((e) => ({ title: e.degree, org: e.school, date: e.dateRange, bullets: e.achievements })),
];
---

<section id="experience" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-20 md:py-28">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
    <SectionTitle title="이력" />
    <ol class="lg:col-span-8 relative border-l-2 border-gray-200 ml-2 flex flex-col gap-10">
      {
        items.map((it) => (
          <li class="relative pl-8">
            <span class="absolute -left-[9px] top-6 w-4 h-4 rounded-full ring-4 ring-white" style="background-color: var(--accent)" />
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 sm:p-6 hover:shadow-md transition-shadow duration-300">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 sm:gap-4 mb-4">
                <div>
                  <h3 class="text-lg sm:text-xl font-semibold text-gray-900">{it.org}</h3>
                  <p class="text-base" style="color: var(--accent)">{it.title}</p>
                </div>
                {it.date && <span class="tabular-nums text-xs sm:text-sm text-gray-500 shrink-0">{it.date}</span>}
              </div>
              <ul class="flex flex-col gap-2">
                {it.bullets.map((b) => (
                  <li class="flex items-start">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 shrink-0" />
                    <span class="text-sm sm:text-base text-gray-600 leading-relaxed">{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
