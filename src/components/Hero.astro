---
import { siteConfig } from "../config";
import MaybeImage from "./MaybeImage.astro";

// 직무별 첫 화면(/data 등)은 hero·roleLabel만 바꿔 넘긴다. 넘기지 않으면 백엔드 기본값.
interface Props {
  hero?: typeof siteConfig.hero;
  roleLabel?: string;
}
const { hero = siteConfig.hero, roleLabel = siteConfig.roleLabel } = Astro.props;
---

<div id="hero" class="relative isolate overflow-hidden bg-white pt-32 pb-20 md:pt-40 md:pb-28">
  <!-- 템플릿의 그라디언트·격자 배경 -->
  <div
    class="absolute inset-0 -z-10"
    style={`background: radial-gradient(ellipse 800px 1000px at 0% 0%, ${siteConfig.accentColor}33 0%, ${siteConfig.accentColor}1a 25%, ${siteConfig.accentColor}0a 45%, rgba(255,255,255,0.4) 70%, white 100%)`}
  >
  </div>
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern x="50%" y={-1} id="hero-grid" width={200} height={200} patternUnits="userSpaceOnUse">
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
    </defs>
    <rect fill="url(#hero-grid)" width="100%" height="100%" stroke-width={0}></rect>
  </svg>

  <div class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <div class="lg:col-span-8">
      <p class="font-mono text-sm sm:text-base font-semibold tracking-wide animate-fade-in" style="color: var(--accent)">
        {hero.eyebrow}
      </p>
      <h1
        class="mt-5 text-3xl sm:text-5xl md:text-6xl font-bold leading-[1.2] text-gray-900 animate-fade-in animation-delay-200"
      >
        {hero.headline}
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-gray-600 animate-fade-in animation-delay-400">
        {roleLabel} <span class="font-semibold" style="color: var(--accent)">{siteConfig.name}</span>입니다.
        {hero.intro && <span class="block mt-2 text-base sm:text-lg">{hero.intro}</span>}
      </p>
      <div class="mt-10 flex flex-wrap gap-3 animate-fade-in animation-delay-600">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-white font-medium transition-opacity hover:opacity-90"
          style="background-color: var(--accent)"
        >
          프로젝트 보기
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg
          >
        </a>
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 bg-white text-gray-800 font-medium ring-1 ring-gray-300 hover:ring-gray-400 transition"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ><path
              d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"
            ></path></svg
          >
          GitHub
        </a>
        <a
          href={`mailto:${siteConfig.social.email}`}
          class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 bg-white text-gray-800 font-medium ring-1 ring-gray-300 hover:ring-gray-400 transition"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path><path d="M3 7l9 6l9 -6"></path></svg
          >
          {siteConfig.social.email}
        </a>
      </div>
    </div>
    <!-- 휴대폰에서는 사진을 작게 줄여 글 위에 둔다(두 번째 화면을 통째로 차지하던 문제) -->
    <div class="order-first lg:order-none lg:col-span-4 animate-fade-in animation-delay-400">
      <MaybeImage
        src={siteConfig.profileImage}
        alt={`${siteConfig.name} 프로필 사진`}
        label="프로필 사진 자리"
        class="w-24 h-32 sm:w-48 sm:h-64 lg:w-60 lg:h-80 rounded-2xl sm:rounded-3xl shadow-xl ring-1 ring-gray-200 lg:ml-auto"
      />
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0.001;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fadeIn 0.7s ease-out both;
  }
  .animation-delay-200 {
    animation-delay: 0.15s;
  }
  .animation-delay-400 {
    animation-delay: 0.3s;
  }
  .animation-delay-600 {
    animation-delay: 0.45s;
  }
</style>
